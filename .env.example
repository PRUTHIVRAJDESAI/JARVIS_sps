# ============================================================================
# J.A.R.V.I.S. // GEMINI CORE EDITION - CONFIGURATION (.env)
# Hardware Target: Salvaged HP Laptop (Motherboard 605747-001, 4GB RAM, LVDS)
# ============================================================================

# LLM PROVIDER SELECTION:
# Options: "gemini" (default - works like Gemini), "claude", "groq", or "auto"
LLM_PROVIDER=auto

# 1. GOOGLE AI STUDIO - GEMINI API (FREE TIER - No Credit Card Required!)
# Get your free API key in 10 seconds at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6IQ9XszjIXK5zIHX4-d6zpz-0VFnlHIB2sguUGivf6DtA
GEMINI_MODEL=gemini-2.5-flash

# 2. ANTHROPIC CLAUDE API (Optional alternative from project spec)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest

# 3. GROQ CLOUD API (Optional free-tier fast alternative)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# DEFAULT WEATHER LOCATION (Open-Meteo API - No API Key Needed!)
DEFAULT_CITY=Margaon
DEFAULT_COUNTRY=India
DEFAULT_LAT=15.4909
DEFAULT_LON=73.8278

# OFFLINE TEXT-TO-SPEECH (pyttsx3)
ENABLE_SERVER_TTS=true
TTS_RATE=180
TTS_VOLUME=1.0

# SERVER SETTINGS
HOST=127.0.0.1
PORT=5000


